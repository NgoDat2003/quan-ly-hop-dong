datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  TRAINER
  TRAINEE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(TRAINEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
