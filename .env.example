DATABASE_URL="postgresql://postgres:postgres@localhost:5433/create_project_from_template?schema=public"
JWT_SECRET="dev-placeholder-secret-not-for-production"
# Note: this differs intentionally from env.schema.ts's own default
# ('dev-placeholder-secret') — the schema throws at boot only when
# NODE_ENV=production and JWT_SECRET still equals that exact code-level
# default, so copying this .env.example value in verbatim will NOT trip
# that guard. Set a real secret before ever running with NODE_ENV=production.

# Optional — all have safe defaults in apps/api/src/config/env.schema.ts,
# only listed here for discoverability.
# JWT_EXPIRES_IN="7d"
# PORT=3001
# WEB_ORIGIN="http://localhost:3000"
# NODE_ENV="development"
