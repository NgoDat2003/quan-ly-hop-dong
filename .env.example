DATABASE_URL="postgresql://postgres:postgres@localhost:5433/create_project_from_template?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-not-for-production"
JWT_REFRESH_SECRET="dev-refresh-secret-not-for-production"
# Note: these differ intentionally from env.schema.ts's own defaults
# ('dev-placeholder-access-secret' / 'dev-placeholder-refresh-secret') —
# the schema throws at boot only when NODE_ENV=production and a secret
# still equals its exact code-level default, so copying these
# .env.example values in verbatim will NOT trip that guard. Set real
# secrets (and make sure the two differ from each other — the schema
# also refuses to boot with matching access/refresh secrets) before ever
# running with NODE_ENV=production.

# Optional — all have safe defaults in apps/api/src/config/env.schema.ts,
# only listed here for discoverability.
# JWT_ACCESS_TTL="15m"
# JWT_REFRESH_TTL="7d"
# AUTH_COOKIE_SECURE="false"   # set "true" in production (HTTPS required)
# PORT=3001
# WEB_ORIGIN="http://localhost:3000"
# NODE_ENV="development"
